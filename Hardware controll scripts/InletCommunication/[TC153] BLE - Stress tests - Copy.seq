					<DescriptionFormat typename='Expression' xsi:type='Expression' classname='ExprValue' flagsforinstances='4718616' instanceoverrideflags='4718616' valueflags='4194328' structureflags='524288'>
						<value>(Step.result.status == "" ? "" : ("{" + Str(Step.result.numeric) + "}, ")) 
+ ResStr("NI_STEPTYPES", "NUMERIC_LIMIT_DESCRIPTION_NAME") 
+ ",  " 
+ 
(
Step.compexpr == ""?
     (
     SearchAndReplace
          (
          SearchAndReplace
               (
               SearchAndReplace
                    (
                         SearchAndReplace
                         ( SearchAndReplace(SearchAndReplace(ResStr("NI_SUBSTEPS",Step.Comp + "_EX"),"%hs",(Step.Limits.Nominal&lt;0?"-":"+")),"%ls",(Step.Limits.Nominal&lt;0 ? "+":"-" ) ),
                              
                              "%hi",
                              (Step.limits.highexpr == "" ? Str(Step.limits.high) : Step.limits.highexpr)
                         ),
                        "%low",
                        (Step.Limits.lowexpr == "" ? Str(Step.limits.low) : Step.limits.lowexpr)
                    ),
                    "%nom",
                    (Step.Limits.NominalExpr== "" ? Str(Step.limits.Nominal) : Step.limits.NominalExpr)
               ), 
              "%tre", 
              ToLower(Step.Limits.ThresholdType) == "percentage"?
              "%" : 
              (
                  ToLower(Step.Limits.ThresholdType) == "delta"? 
                  "": 
                  (
                 ToLower(Step.Limits.ThresholdType) == "ppm"? 
                 "ppm" :
                 Str(Step.Limits.ThresholdType)
                  )
             )
         )
     ) 
: (ResStr("NI_SUBSTEPS", "COMP_TYPE_EXPR_DESC"))
) 
+ (Step.Result.Units == "" ? "" : ", " + Step.Result.Units)  
+ (("%ModuleDescription" == "") ? "" : ", %ModuleDescription")</value>
					</DescriptionFormat>
					<DefaultNameFormat typename='Expression' xsi:type='Expression' classname='ExprValue' flagsforinstances='4718616' instanceoverrideflags='4718616' valueflags='4194328' structureflags='524288'>
